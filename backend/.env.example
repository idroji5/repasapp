# --- Servidor ---
PORT=3000
NODE_ENV=development
# Secreto para firmar los tokens de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-en-produccion

# --- Base de datos ---
DATABASE_URL=postgres://repasapp:repasapp@localhost:5433/repasapp

# --- Voz (ElevenLabs) ---
# Sin clave, el servidor arranca igual y sirve audio en modo silencioso
# (útil para desarrollar la app sin gastar créditos).
ELEVENLABS_API_KEY=
# Voz femenina castellana. Lista las de tu cuenta con: npm run tts:voces
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Carpeta donde se cachean los MP3 generados
AUDIO_CACHE_DIR=./data/audio

# --- Corrección por visión (Anthropic) ---
ANTHROPIC_API_KEY=
